-- ====================== SLIDER CREATOR ======================
local function AddSlider(icon, name, min, max, default, callback)
    local Container = Instance.new("Frame")
    Container.Size = UDim2.new(1, -10, 0, 65)
    Container.BackgroundColor3 = Themes[CurrentTheme].Panel
    Container.Parent = Scroll
    Instance.new("UICorner", Container).CornerRadius = UDim.new(0, 8)

    local Icon = Instance.new("TextLabel")
    Icon.Size = UDim2.new(0, 28, 0, 28)
    Icon.Position = UDim2.new(0, 10, 0, 8)
    Icon.BackgroundTransparency = 1
    Icon.Text = icon
    Icon.TextSize = 20
    Icon.Parent = Container

    local NameLabel = Instance.new("TextLabel")
    NameLabel.Size = UDim2.new(1, -60, 0, 25)
    NameLabel.Position = UDim2.new(0, 48, 0, 10)
    NameLabel.BackgroundTransparency = 1
    NameLabel.Text = name .. ": " .. default
    NameLabel.TextColor3 = Themes[CurrentTheme].Text
    NameLabel.TextSize = 13
    NameLabel.Font = Enum.Font.GothamMedium
    NameLabel.TextXAlignment = Enum.TextXAlignment.Left
    NameLabel.Parent = Container

    local SliderBG = Instance.new("Frame")
    SliderBG.Size = UDim2.new(1, -60, 0, 8)
    SliderBG.Position = UDim2.new(0, 48, 0, 45)
    SliderBG.BackgroundColor3 = Color3.fromRGB(60, 60, 65)
    SliderBG.Parent = Container
    Instance.new("UICorner", SliderBG).CornerRadius = UDim.new(1, 0)

    local SliderFill = Instance.new("Frame")
    local percent = (default - min) / (max - min)
    SliderFill.Size = UDim2.new(percent, 0, 1, 0)
    SliderFill.BackgroundColor3 = Themes[CurrentTheme].Accent
    SliderFill.Parent = SliderBG
    Instance.new("UICorner", SliderFill).CornerRadius = UDim.new(1, 0)

    local SliderKnob = Instance.new("Frame")
    SliderKnob.Size = UDim2.new(0, 18, 0, 18)
    SliderKnob.Position = UDim2.new(percent, -9, 0.5, -9)
    SliderKnob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    SliderKnob.Parent = SliderBG
    Instance.new("UICorner", SliderKnob).CornerRadius = UDim.new(1, 0)

    local value = default
    local dragging = false
    local function Update(input)
        local pos = math.clamp((input.Position.X - SliderBG.AbsolutePosition.X) / SliderBG.AbsoluteSize.X, 0, 1)
        value = math.floor(min + pos * (max - min))
        NameLabel.Text = name .. ": " .. value
        SliderFill.Size = UDim2.new(pos, 0, 1, 0)
        SliderKnob.Position = UDim2.new(pos, -9, 0.5, -9)
        callback(value)
    end
    SliderBG.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true Update(input) end end)
    UIS.InputChanged:Connect(function(input) if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then Update(input) end end)
    UIS.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end end)
end

